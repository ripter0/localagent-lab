# Rebuild with: ollama create qwen-plannig -f qwen-plannig.Modelfile
# Same weights as qwen3.5:9b (ollama pull qwen3.5:9b first)
FROM qwen3.5:9b

PARAMETER num_ctx 32768
PARAMETER num_predict -1
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
PARAMETER temperature 0.6
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER min_p 0
