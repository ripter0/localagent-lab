# Rebuild with: ollama create qwen3.5-fix -f qwen3.5-fix.Modelfile
# Same weights as qwen3.5:9b (ollama pull qwen3.5:9b first)
FROM qwen3.5:9b

PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER min_p 0
PARAMETER num_ctx 16384
PARAMETER num_predict 4096
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
PARAMETER temperature 0.6
